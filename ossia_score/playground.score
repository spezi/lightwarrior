5.5,-160.0],"Size":[107.515625,22.0],"Loops":false,"Script":"import Score\nimport QtQuick\n\nScript {\n  ValueInlet { id: r }\n  ValueInlet { id: g }\n  ValueInlet { id: b }\n  ValueInlet { id: a }\n  ValueOutlet { id: col }\n\n  FloatSlider { id: rFader; objectName: \"R\"; min: 0.0; max: 1.0; init: 0.0 }\n  FloatSlider { id: gFader; objectName: \"G\"; min: 0.0; max: 1.0; init: 0.0 }\n  FloatSlider { id: bFader; objectName: \"B\"; min: 0.0; max: 1.0; init: 0.0 }\n  FloatSlider { id: aFader; objectName: \"A\"; min: 0.0; max: 1.0; init: 1.0 }\n\n  property bool rSeen: false\n  property bool gSeen: false\n  property bool bSeen: false\n  property bool aSeen: false\n  property real rv: 0.0\n  property real gv: 0.0\n  property real bv: 0.0\n  property real av: 1.0\n  \n\n  tick: function(token, state) {\n    if (typeof r.value !== 'undefined') { rv = r.value; rSeen = true; }\n    if (typeof g.value !== 'undefined') { gv = g.value; gSeen = true; }\n    if (typeof b.value !== 'undefined') { bv = b.value; bSeen = true; }\n    if (typeof a.value !== 'undefined') { av = b.value; aSeen = true; }\n\n    var outR = rSeen ? rv : rFader.value;\n    var outG = gSeen ? gv : gFader.value;\n    var outB = bSeen ? bv : bFader.value;\n    var outA = aSeen ? av : aFader.value;\n\n    col.setValue(Qt.vector4d(outR, outG, outB, outA));\n  }\n}","Inlets":[{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":0,"Hidden":false,"Custom":"Value in","Exposed":"value in"},{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":1,"Hidden":false,"Custom":"Value in","Exposed":"value in"},{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":2,"Hidden":false,"Custom":"Value in","Exposed":"value in"},{"uuid":"769dd38a-bfb3-4dc6-b52a-b6abb7afe2a3","ObjectName":"Inlet","id":3,"Hidden":false,"Custom":"Value in","Exposed":"value in"},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"R","Exposed":"r","Val