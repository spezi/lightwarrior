defmodule LightwarriorWeb.HyperionConfigLive.Form do
  use LightwarriorWeb, :live_view

  alias Lightwarrior.Hyperion
  alias Lightwarrior.Hyperion.HyperionConfig

  @impl true
  def render(assigns) do
    ~H"""
    <Layouts.app flash={@flash}>
      <.header>
        {@page_title}
        <:subtitle>Use this form to manage hyperion_config records in your database.</:subtitle>
      </.header>

      <.form for={@form} id="hyperion_config-form" phx-change="validate" phx-submit="save">
        <.input field={@form[:name]} type="text" label="Name" />
        <footer>
          <.button phx-disable-with="Saving..." variant="primary">Save Hyperion config</.button>
          <.button navigate={return_path(@return_to, @hyperion_config)}>Cancel</.button>
        </footer>
      </.form>
    </Layouts.app>
    """
  end

  @impl true
  def mount(params, _session, socket) do
    {:ok,
     socket
     |> assign(:return_to, return_to(params["return_to"]))
     |> apply_action(socket.assigns.live_action, params)}
  end

  defp return_to("show"), do: "show"
  defp return_to(_), do: "index"

  defp apply_action(socket, :edit, %{"id" => id}) do
    hyperion_config = Hyperion.get_hyperion_config!(id)

    socket
    |> assign(:page_title, "Edit Hyperion config")
    |> assign(:hyperion_config, hyperion_config)
    |> assign(:form, to_form(Hyperion.change_hyperion_config(hyperion_config)))
  end

  defp apply_action(socket, :new, _params) do
    hyperion_config = %HyperionConfig{}

    socket
    |> assign(:page_title, "New Hyperion config")
    |> assign(:hyperion_config, hyperion_config)
    |> assign(:form, to_form(Hyperion.change_hyperion_config(hyperion_config)))
  end

  @impl true
  def handle_event("validate", %{"hyperion_config" => hyperion_config_params}, socket) do
    changeset = Hyperion.change_hyperion_config(socket.assigns.hyperion_config, hyperion_config_params)
    {:noreply, assign(socket, form: to_form(changeset, action: :validate))}
  end

  def handle_event("save", %{"hyperion_config" => hyperion_config_params}, socket) do
    save_hyperion_config(socket, socket.assigns.live_action, hyperion_config_params)
  end

  defp save_hyperion_config(socket, :edit, hyperion_config_params) do
    case Hyperion.update_hyperion_config(socket.assigns.hyperion_config, hyperion_config_params) do
      {:ok, hyperion_config} ->
        {:noreply,
         socket
         |> put_flash(:info, "Hyperion config updated successfully")
         |> push_navigate(to: return_path(socket.assigns.return_to, hyperion_config))}

      {:error, %Ecto.Changeset{} = changeset} ->
        {:noreply, assign(socket, form: to_form(changeset))}
    end
  end

  defp save_hyperion_config(socket, :new, hyperion_config_params) do
    case Hyperion.create_hyperion_config(hyperion_config_params) do
      {:ok, hyperion_config} ->
        {:noreply,
         socket
         |> put_flash(:info, "Hyperion config created successfully")
         |> push_navigate(to: return_path(socket.assigns.return_to, hyperion_config))}

      {:error, %Ecto.Changeset{} = changeset} ->
        {:noreply, assign(socket, form: to_form(changeset))}
    end
  end

  defp return_path("index", _hyperion_config), do: ~p"/hyperionconfigs"
  defp return_path("show", hyperion_config), do: ~p"/hyperionconfigs/#{hyperion_config}"
end
