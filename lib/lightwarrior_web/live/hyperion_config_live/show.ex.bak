defmodule LightwarriorWeb.HyperionConfigLive.Show do
  use LightwarriorWeb, :live_view

  alias Lightwarrior.Hyperion

  @impl true
  def render(assigns) do
    ~H"""
    <Layouts.app flash={@flash}>
      <.header>
        Hyperion config {@hyperion_config.id}
        <:subtitle>This is a hyperion_config record from your database.</:subtitle>
        <:actions>
          <.button navigate={~p"/hyperionconfigs"}>
            <.icon name="hero-arrow-left" />
          </.button>
          <.button variant="primary" navigate={~p"/hyperionconfigs/#{@hyperion_config}/edit?return_to=show"}>
            <.icon name="hero-pencil-square" /> Edit hyperion_config
          </.button>
        </:actions>
      </.header>

      <.list>
        <:item title="Name">{@hyperion_config.name}</:item>
      </.list>
    </Layouts.app>
    """
  end

  @impl true
  def mount(%{"id" => id}, _session, socket) do
    {:ok,
     socket
     |> assign(:page_title, "Show Hyperion config")
     |> assign(:hyperion_config, Hyperion.get_hyperion_config!(id))}
  end
end
