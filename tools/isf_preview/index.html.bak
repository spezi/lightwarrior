<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ISF Preview · local shader playground</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Archivo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0c10;
    --panel: #11141b;
    --panel-2: #161a23;
    --line: #232938;
    --ink: #e7ecf3;
    --ink-dim: #8a93a6;
    --ink-faint: #5a6072;
    --acc: #4cf0c0;
    --acc-2: #ff5d7a;
    --warn: #ffb454;
    --err: #ff5d7a;
    --shadow: 0 18px 50px -20px rgba(0,0,0,.8);
    --r: 10px;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    background:
      radial-gradient(1200px 600px at 80% -10%, rgba(76,240,192,.07), transparent 60%),
      radial-gradient(900px 500px at -5% 110%, rgba(255,93,122,.06), transparent 55%),
      var(--bg);
    color: var(--ink);
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .mono { font-family: 'Space Mono', monospace; }

  /* ---- layout ---- */
  .app {
    display: grid;
    grid-template-columns: 360px 1fr;
    grid-template-rows: 56px 1fr;
    grid-template-areas: "brand top" "side stage";
    height: 100vh;
  }
  header {
    grid-area: top;
    display: flex; align-items: center; gap: 18px;
    padding: 0 22px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255,255,255,.02), transparent);
  }
  .brand {
    grid-area: brand;
    display: flex; align-items: center; gap: 11px;
    padding: 0 20px;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .brand .dot {
    width: 13px; height: 13px; border-radius: 50%;
    background: var(--acc);
    box-shadow: 0 0 16px var(--acc);
    animation: pulse 3s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity:.45; box-shadow:0 0 6px var(--acc);} }
  .brand b { font-weight: 800; letter-spacing: .04em; }
  .brand span { color: var(--ink-faint); font-size: 11px; }

  aside {
    grid-area: side;
    border-right: 1px solid var(--line);
    background: var(--panel);
    overflow-y: auto;
    display: flex; flex-direction: column;
  }
  main {
    grid-area: stage;
    position: relative;
    display: flex; flex-direction: column;
    min-width: 0; min-height: 0;
  }

  /* ---- header bits ---- */
  .htitle { font-weight: 600; font-size: 13px; color: var(--ink-dim); letter-spacing:.02em; }
  .htitle b { color: var(--ink); }
  .spacer { flex: 1; }
  .stat { font-size: 11px; color: var(--ink-faint); display:flex; gap:6px; align-items:center;}
  .stat b { color: var(--acc); font-weight: 700; }
  .badge {
    font-size: 10px; padding: 3px 8px; border-radius: 20px;
    border: 1px solid var(--line); color: var(--ink-dim);
    letter-spacing:.08em; text-transform: uppercase;
  }

  /* ---- buttons / dropzones ---- */
  .section { padding: 16px 18px; border-bottom: 1px solid var(--line); }
  .section h3 {
    margin: 0 0 11px; font-size: 11px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-faint); font-weight: 700;
    display:flex; align-items:center; gap:8px;
  }
  .section h3::before {
    content:""; width:5px; height:5px; background: var(--acc); border-radius:50%;
  }
  .drop {
    border: 1.5px dashed var(--line); border-radius: var(--r);
    padding: 18px 14px; text-align: center; cursor: pointer;
    transition: border-color .15s, background .15s, transform .1s;
    background: var(--panel-2);
  }
  .drop:hover { border-color: var(--acc); background: #181d27; }
  .drop.over { border-color: var(--acc); background: rgba(76,240,192,.08); transform: scale(1.01); }
  .drop .big { font-weight: 600; margin-bottom: 4px; }
  .drop .small { font-size: 11px; color: var(--ink-faint); }
  .drop .fname { color: var(--acc); font-size: 11.5px; word-break: break-all; }

  .row { display:flex; gap: 9px; margin-top: 10px; }
  button.btn {
    font-family: 'Archivo', sans-serif; font-size: 12px; font-weight: 600;
    color: var(--ink); background: var(--panel-2);
    border: 1px solid var(--line); border-radius: 7px;
    padding: 8px 11px; cursor: pointer; transition: .12s;
    display:flex; align-items:center; gap:6px; justify-content:center; flex:1;
  }
  button.btn:hover { border-color: var(--acc); color: var(--acc); }
  button.btn:active { transform: translateY(1px); }
  button.btn.ghost { background: transparent; }

  /* ---- controls ---- */
  #inputs { flex:1; }
  .ctl { margin-bottom: 16px; }
  .ctl:last-child { margin-bottom: 4px; }
  .ctl label {
    display:flex; justify-content:space-between; align-items:baseline;
    font-size: 12px; margin-bottom: 7px;
  }
  .ctl label .name { font-weight: 600; }
  .ctl label .val { font-family:'Space Mono',monospace; font-size: 11px; color: var(--acc); }
  .ctl label .ty { font-size:9px; color: var(--ink-faint); letter-spacing:.1em; text-transform:uppercase; margin-left:6px;}

  input[type=range] {
    -webkit-appearance:none; appearance:none; width:100%; height:4px;
    background: var(--line); border-radius:4px; outline:none; cursor:pointer;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance:none; width:15px; height:15px; border-radius:50%;
    background: var(--acc); cursor:pointer; box-shadow:0 0 0 3px rgba(76,240,192,.18);
    transition: box-shadow .12s;
  }
  input[type=range]::-webkit-slider-thumb:hover { box-shadow:0 0 0 5px rgba(76,240,192,.25); }
  input[type=range]::-moz-range-thumb {
    width:15px;height:15px;border:none;border-radius:50%;background:var(--acc);
    box-shadow:0 0 0 3px rgba(76,240,192,.18);
  }

  .swatch-wrap { display:flex; align-items:center; gap:10px; }
  input[type=color] {
    -webkit-appearance:none; appearance:none; width:42px; height:30px;
    border:1px solid var(--line); border-radius:7px; background:none; cursor:pointer; padding:0;
  }
  input[type=color]::-webkit-color-swatch-wrapper { padding:3px; }
  input[type=color]::-webkit-color-swatch { border:none; border-radius:5px; }

  .toggle {
    width: 44px; height: 24px; border-radius: 20px; background: var(--line);
    position: relative; cursor: pointer; transition: background .15s; flex:none;
  }
  .toggle::after {
    content:""; position:absolute; top:3px; left:3px; width:18px; height:18px;
    border-radius:50%; background:var(--ink-dim); transition:.15s;
  }
  .toggle.on { background: rgba(76,240,192,.3); }
  .toggle.on::after { left:23px; background: var(--acc); }

  select.sel {
    width:100%; font-family:'Space Mono',monospace; font-size:12px;
    background: var(--panel-2); color: var(--ink);
    border:1px solid var(--line); border-radius:7px; padding:8px 10px; cursor:pointer;
  }

  .xy {
    position: relative; width: 100%; aspect-ratio: 16/9;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0/100% 25%,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0/25% 100%,
      var(--panel-2);
    border:1px solid var(--line); border-radius:8px; cursor:crosshair; overflow:hidden;
  }
  .xy .pt {
    position:absolute; width:14px; height:14px; border-radius:50%;
    background: var(--acc); transform: translate(-50%,-50%);
    box-shadow:0 0 12px var(--acc); pointer-events:none;
  }
  .xy .pt::before, .xy .pt::after {
    content:""; position:absolute; background: rgba(76,240,192,.4);
  }
  .xy .pt::before { left:50%; top:-200px; width:1px; height:400px; transform:translateX(-50%);}
  .xy .pt::after { top:50%; left:-200px; height:1px; width:400px; transform:translateY(-50%);}

  .empty { color: var(--ink-faint); font-size: 12px; text-align:center; padding: 24px 8px; line-height:1.6; }

  /* image input control */
  .imgctl { display:flex; gap:10px; align-items:center; }
  .imgctl .thumb {
    width:54px; height:54px; border-radius:7px; border:1px solid var(--line);
    object-fit:cover; background:var(--panel-2); flex:none;
  }
  .imgctl .imgbtns { flex:1; display:flex; flex-direction:column; gap:6px; }
  .imgctl select.sel { padding:6px 8px; font-size:11px; }
  .mini {
    font-size:11px; padding:6px 8px; border-radius:6px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--ink-dim); cursor:pointer; text-align:center; transition:.12s;
  }
  .mini:hover { border-color:var(--acc); color:var(--acc); }

  /* ---- stage ---- */
  .stagebar {
    height: 46px; display:flex; align-items:center; gap:14px; padding: 0 18px;
    border-bottom: 1px solid var(--line); background: var(--panel);
  }
  .stagebar .grp { display:flex; gap:7px; align-items:center; }
  .iconbtn {
    width:32px; height:32px; border-radius:7px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--ink-dim); cursor:pointer; display:grid; place-items:center;
    transition:.12s; font-size:13px;
  }
  .iconbtn:hover { border-color:var(--acc); color:var(--acc); }
  .iconbtn.active { color:var(--acc); border-color:var(--acc); background:rgba(76,240,192,.08);}
  .seg { display:flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; }
  .seg button {
    background:var(--panel-2); border:none; color:var(--ink-dim); font-size:11px;
    padding:7px 11px; cursor:pointer; font-family:'Space Mono',monospace; transition:.12s;
  }
  .seg button.on { background:rgba(76,240,192,.12); color:var(--acc); }
  .seg button:not(:last-child){ border-right:1px solid var(--line); }

  .canvas-wrap {
    flex:1; min-height:0; position:relative; display:grid; place-items:center;
    padding: 22px;
    background-image:
      linear-gradient(45deg, #0d0f15 25%, transparent 25%),
      linear-gradient(-45deg, #0d0f15 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #0d0f15 75%),
      linear-gradient(-45deg, transparent 75%, #0d0f15 75%);
    background-size: 24px 24px;
    background-position: 0 0, 0 12px, 12px -12px, -12px 0px;
  }
  canvas#gl {
    max-width:100%; max-height:100%;
    border-radius: 6px; box-shadow: var(--shadow);
    background:#000; image-rendering:auto;
  }
  canvas#gl.pixel { image-rendering: pixelated; }

  .overlay {
    position:absolute; inset:22px; display:grid; place-items:center;
    pointer-events:none;
  }
  .placard {
    text-align:center; color:var(--ink-faint); max-width:380px; line-height:1.7;
    pointer-events:auto;
  }
  .placard .k { color:var(--acc); }
  .placard svg { opacity:.5; margin-bottom:14px; }

  .errbox {
    position:absolute; left:18px; right:18px; bottom:18px;
    background: #1a1014; border:1px solid var(--err); border-radius:8px;
    padding:13px 15px; font-family:'Space Mono',monospace; font-size:12px;
    color:#ffb3c1; max-height:40%; overflow:auto; box-shadow: var(--shadow);
    display:none;
  }
  .errbox.show{ display:block; }
  .errbox b{ color: var(--err); display:block; margin-bottom:6px; letter-spacing:.05em;}

  .hint { font-size:11px; color:var(--ink-faint); margin-top:8px; line-height:1.5;}
  code.kbd {
    font-family:'Space Mono',monospace; background:var(--panel-2);
    border:1px solid var(--line); border-radius:4px; padding:1px 5px; font-size:11px; color:var(--ink-dim);
  }
  ::-webkit-scrollbar{ width:9px; height:9px;}
  ::-webkit-scrollbar-thumb{ background:var(--line); border-radius:6px;}
  ::-webkit-scrollbar-track{ background:transparent;}
  input[type=file]{ display:none; }
</style>
</head>
<body>
<div class="app">
  <div class="brand">
    <div class="dot"></div>
    <div>
      <b class="mono">ISF·PREVIEW</b><br>
      <span class="mono">local playground</span>
    </div>
  </div>

  <header>
    <div class="htitle">Shader: <b id="shaderName">— none loaded —</b></div>
    <span class="badge" id="typeBadge" style="display:none"></span>
    <div class="spacer"></div>
    <div class="stat"><span id="fpsLabel" class="mono">0</span><span class="mono">fps</span></div>
    <div class="stat mono" id="resLabel">—</div>
  </header>

  <aside>
    <div class="section">
      <h3>Shader source</h3>
      <div class="drop" id="dropFs">
        <div class="big">Drop an .fs / ISF shader</div>
        <div class="small">or click to browse · <span class="fname" id="fsName"></span></div>
      </div>
      <div class="row">
        <button class="btn ghost" id="loadExample">⚡ Load example</button>
        <button class="btn ghost" id="pickFs">📂 Browse</button>
      </div>
      <input type="file" id="fsInput" accept=".fs,.txt,.glsl,.frag,*/*">
    </div>

    <div class="section">
      <h3>Image inputs</h3>
      <div class="drop" id="dropImg">
        <div class="big">Drop an image</div>
        <div class="small">png · jpg · webp · gif — assigned to selected input</div>
      </div>
      <input type="file" id="imgInput" accept="image/*">
      <div id="imageSlots"></div>
    </div>

    <div class="section" id="inputs">
      <h3>Parameters</h3>
      <div id="inputList"><div class="empty">Load a shader to see its INPUTS here.</div></div>
    </div>
  </aside>

  <main>
    <div class="stagebar">
      <div class="grp">
        <button class="iconbtn active" id="playBtn" title="Play / pause (space)">⏸</button>
        <button class="iconbtn" id="resetBtn" title="Reset time">⟲</button>
      </div>
      <div class="grp">
        <span class="mono" style="font-size:11px;color:var(--ink-faint)">RES</span>
        <div class="seg" id="resSeg">
          <button data-r="fit" class="on">fit</button>
          <button data-r="512">512</button>
          <button data-r="720">720p</button>
          <button data-r="1080">1080p</button>
        </div>
      </div>
      <div class="grp">
        <button class="iconbtn" id="pixelBtn" title="Toggle pixelated scaling">▦</button>
        <button class="iconbtn" id="snapBtn" title="Save PNG snapshot">⤓</button>
      </div>
      <div class="spacer"></div>
      <div class="stat mono" id="passLabel" style="font-size:11px"></div>
    </div>

    <div class="canvas-wrap" id="cwrap">
      <canvas id="gl" width="640" height="360"></canvas>
      <div class="overlay" id="overlay">
        <div class="placard">
          <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18M9 3v18"/>
          </svg>
          <div>Drop an <span class="k">ISF .fs shader</span> on the left panel to begin.<br>
          Then drop an image to feed its <code class="kbd">inputImage</code>.<br><br>
          Toggle play with <code class="kbd">space</code> · snapshot with <code class="kbd">S</code>.</div>
        </div>
      </div>
      <div class="errbox" id="errbox"><b>SHADER ERROR</b><div id="errtext"></div></div>
    </div>
  </main>
</div>

<script src="lib/isf.js"></script>
<script>
"use strict";
(function(){
  const ISF = window.interactiveShaderFormat;
  if (!ISF) { alert("Could not load lib/isf.js — keep it next to index.html."); return; }
  const { Renderer, Parser } = ISF;

  const canvas = document.getElementById('gl');
  const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
  if (!gl) { alert("WebGL not available in this browser."); return; }

  // ---------- state ----------
  let renderer = null;
  let parser = null;
  let playing = true;
  let resMode = 'fit';      // 'fit' | number (height)
  let aspect = 16/9;
  let rafId = null;
  const images = {};        // inputName -> {img, label}
  let selectedImageInput = null;

  // ---------- element refs ----------
  const $ = id => document.getElementById(id);
  const overlay = $('overlay'), errbox = $('errbox'), errtext = $('errtext');
  const inputList = $('inputList'), imageSlots = $('imageSlots');

  // ---------- loading shaders ----------
  function loadShaderSource(src, name){
    parser = new Parser();
    parser.parse(src);
    if (!parser.valid){
      showError("Parse error: " + (parser.error && parser.error.message || parser.error));
      return;
    }
    try {
      renderer = new Renderer(gl);
      renderer.loadSource(src);
    } catch(e){
      showError("Renderer error: " + (e.message||e));
      return;
    }
    if (renderer.valid === false){
      const ln = renderer.errorLine != null ? "  (line ~"+renderer.errorLine+")" : "";
      showError("Compile error"+ln+":\n" + (renderer.error && renderer.error.message || renderer.error));
      return;
    }
    clearError();
    $('shaderName').textContent = name || 'untitled';
    const tb = $('typeBadge');
    tb.style.display='inline-block'; tb.textContent = parser.type || 'shader';
    $('passLabel').textContent = (parser.passes && parser.passes.length>1)
        ? parser.passes.length + ' passes' : '';
    overlay.style.display='none';
    buildControls();
    // re-apply any already loaded images to matching inputs
    Object.keys(images).forEach(applyImage);
    if (!playing) togglePlay();
  }

  function showError(msg){
    errtext.textContent = msg;
    errbox.classList.add('show');
  }
  function clearError(){ errbox.classList.remove('show'); }

  // ---------- controls (auto-generated from parser.inputs) ----------
  const RESERVED = new Set(['TIME','TIMEDELTA','FRAMEINDEX','PASSINDEX','RENDERSIZE','DATE']);

  function buildControls(){
    inputList.innerHTML = '';
    imageSlots.innerHTML = '';
    const inputs = (parser.inputs||[]).filter(i => !RESERVED.has(i.NAME));

    const imageInputs = inputs.filter(i => i.TYPE==='image');
    const paramInputs = inputs.filter(i => i.TYPE!=='image');

    // image slot picker
    if (imageInputs.length===0){
      imageSlots.innerHTML = '<div class="hint">This shader declares no image inputs (it\'s a generator).</div>';
      selectedImageInput = null;
    } else {
      if (!selectedImageInput || !imageInputs.find(i=>i.NAME===selectedImageInput))
        selectedImageInput = imageInputs[0].NAME;
      imageInputs.forEach(inp => imageSlots.appendChild(imageSlotEl(inp)));
    }

    if (paramInputs.length===0){
      inputList.innerHTML = '<div class="empty">No adjustable parameters.</div>';
      return;
    }
    paramInputs.forEach(inp => inputList.appendChild(controlEl(inp)));
  }

  function imageSlotEl(inp){
    const wrap = document.createElement('div');
    wrap.className='ctl';
    const has = images[inp.NAME];
    wrap.innerHTML = `
      <label><span class="name">${inp.NAME}</span><span class="ty">image</span></label>
      <div class="imgctl">
        <img class="thumb" src="${has?has.img.src:''}" alt="">
        <div class="imgbtns">
          <div class="mini" data-pick="${inp.NAME}">${has? 'Replace image…':'Choose image…'}</div>
          ${has? `<div class="mini" data-clear="${inp.NAME}">Clear</div>`:''}
        </div>
      </div>`;
    wrap.querySelector('[data-pick]').onclick = ()=>{ selectedImageInput = inp.NAME; openImagePicker(); };
    const clr = wrap.querySelector('[data-clear]');
    if (clr) clr.onclick = ()=>{ delete images[inp.NAME]; buildControls(); };
    // clicking the row selects it as drop target
    wrap.onclick = ()=>{ selectedImageInput = inp.NAME; };
    return wrap;
  }

  function controlEl(inp){
    const wrap = document.createElement('div');
    wrap.className = 'ctl';
    const t = inp.TYPE;

    if (t === 'float' || t === 'long'){
      const isLong = t==='long' && Array.isArray(inp.VALUES);
      if (isLong){
        // dropdown for enumerated long
        wrap.innerHTML = `<label><span class="name">${inp.NAME}</span><span class="ty">long</span></label>`;
        const sel = document.createElement('select'); sel.className='sel';
        inp.VALUES.forEach((v,i)=>{
          const o=document.createElement('option'); o.value=v;
          o.textContent=(inp.LABELS&&inp.LABELS[i])!=null?inp.LABELS[i]:v;
          sel.appendChild(o);
        });
        const def = inp.DEFAULT!=null?inp.DEFAULT:inp.VALUES[0];
        sel.value = def; setVal(inp.NAME, def);
        sel.onchange = ()=> setVal(inp.NAME, parseInt(sel.value,10));
        wrap.appendChild(sel);
        return wrap;
      }
      const min = inp.MIN!=null?inp.MIN:(t==='long'?0:0);
      const max = inp.MAX!=null?inp.MAX:(t==='long'?100:1);
      const def = inp.DEFAULT!=null?inp.DEFAULT:(min+max)/2;
      const step = t==='long'?1:(max-min)/500 || 0.001;
      wrap.innerHTML = `<label><span class="name">${inp.NAME}<span class="ty">${t}</span></span>
        <span class="val" id="v_${cssId(inp.NAME)}">${fmt(def)}</span></label>`;
      const r = document.createElement('input');
      r.type='range'; r.min=min; r.max=max; r.step=step; r.value=def;
      setVal(inp.NAME, t==='long'?Math.round(def):def);
      r.oninput = ()=>{
        const val = t==='long'?Math.round(+r.value):+r.value;
        setVal(inp.NAME, val);
        $('v_'+cssId(inp.NAME)).textContent = fmt(val);
      };
      wrap.appendChild(r);
      return wrap;
    }

    if (t === 'bool' || t === 'event'){
      wrap.innerHTML = `<label><span class="name">${inp.NAME}<span class="ty">${t}</span></span></label>`;
      const tg = document.createElement('div'); tg.className='toggle';
      const def = !!inp.DEFAULT; if(def) tg.classList.add('on');
      setVal(inp.NAME, def?1:0);
      tg.onclick = ()=>{ tg.classList.toggle('on'); setVal(inp.NAME, tg.classList.contains('on')?1:0); };
      const lab = wrap.querySelector('label'); lab.appendChild(tg);
      return wrap;
    }

    if (t === 'color'){
      const d = inp.DEFAULT || [1,1,1,1];
      wrap.innerHTML = `<label><span class="name">${inp.NAME}<span class="ty">color</span></span>
        <span class="val" id="v_${cssId(inp.NAME)}">${rgbaStr(d)}</span></label>`;
      const sw = document.createElement('div'); sw.className='swatch-wrap';
      const c = document.createElement('input'); c.type='color'; c.value = rgbToHex(d);
      const a = document.createElement('input'); a.type='range'; a.min=0;a.max=1;a.step=0.01;
      a.value = d[3]!=null?d[3]:1; a.title='alpha'; a.style.flex='1';
      setVal(inp.NAME, [d[0],d[1],d[2],+a.value]);
      const push = ()=>{
        const rgb = hexToRgb(c.value); const arr=[rgb[0],rgb[1],rgb[2],+a.value];
        setVal(inp.NAME, arr); $('v_'+cssId(inp.NAME)).textContent = rgbaStr(arr);
      };
      c.oninput = push; a.oninput = push;
      sw.appendChild(c); sw.appendChild(a); wrap.appendChild(sw);
      return wrap;
    }

    if (t === 'point2D'){
      const d = inp.DEFAULT || [0.5,0.5];
      wrap.innerHTML = `<label><span class="name">${inp.NAME}<span class="ty">point2D</span></span>
        <span class="val" id="v_${cssId(inp.NAME)}">${d[0].toFixed(2)}, ${d[1].toFixed(2)}</span></label>`;
      const pad = document.createElement('div'); pad.className='xy';
      const pt = document.createElement('div'); pt.className='pt';
      pad.appendChild(pt);
      const place = (x,y)=>{ pt.style.left=(x*100)+'%'; pt.style.top=((1-y)*100)+'%'; };
      place(d[0],d[1]); setVal(inp.NAME, [d[0],d[1]]);
      const onMove = e=>{
        const r=pad.getBoundingClientRect();
        const cx = (e.touches?e.touches[0].clientX:e.clientX);
        const cy = (e.touches?e.touches[0].clientY:e.clientY);
        let x=(cx-r.left)/r.width, y=1-(cy-r.top)/r.height;
        x=Math.max(0,Math.min(1,x)); y=Math.max(0,Math.min(1,y));
        place(x,y); setVal(inp.NAME,[x,y]);
        $('v_'+cssId(inp.NAME)).textContent = x.toFixed(2)+', '+y.toFixed(2);
      };
      let drag=false;
      pad.addEventListener('mousedown', e=>{drag=true;onMove(e);});
      window.addEventListener('mousemove', e=>{if(drag)onMove(e);});
      window.addEventListener('mouseup', ()=>drag=false);
      pad.addEventListener('touchstart', e=>{onMove(e);e.preventDefault();},{passive:false});
      pad.addEventListener('touchmove', e=>{onMove(e);e.preventDefault();},{passive:false});
      wrap.appendChild(pad);
      return wrap;
    }

    wrap.innerHTML = `<label><span class="name">${inp.NAME}</span><span class="ty">${t}?</span></label>
      <div class="hint">Unsupported input type — left at default.</div>`;
    return wrap;
  }

  function setVal(name, value){
    if (!renderer || renderer.valid===false) return;
    try { renderer.setValue(name, value); } catch(e){ /* uniform may be optimized out */ }
  }

  // ---------- images ----------
  function openImagePicker(){ $('imgInput').click(); }

  function handleImageFile(file){
    if (!file) return;
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = ()=>{
      const target = selectedImageInput
        || (parser && (parser.inputs||[]).find(i=>i.TYPE==='image') || {}).NAME
        || 'inputImage';
      images[target] = { img, label:file.name };
      applyImage(target);
      buildControls();
    };
    img.src = url;
  }

  function applyImage(name){
    const rec = images[name]; if(!rec || !renderer) return;
    try {
      renderer.setValue(name, rec.img);
      renderer.pushTextures();
    } catch(e){ /* input not present in this shader */ }
  }

  // ---------- render loop ----------
  function sizeCanvas(){
    const wrap = $('cwrap');
    if (resMode === 'fit'){
      const pad = 44;
      const availW = wrap.clientWidth - pad, availH = wrap.clientHeight - pad;
      let w = availW, h = w/aspect;
      if (h > availH){ h = availH; w = h*aspect; }
      canvas.width = Math.max(2, Math.round(w));
      canvas.height = Math.max(2, Math.round(h));
      canvas.style.width=''; canvas.style.height='';
    } else {
      const h = +resMode, w = Math.round(h*aspect);
      canvas.width = w; canvas.height = h;
    }
    $('resLabel').textContent = canvas.width+'×'+canvas.height;
  }

  let frames=0, fpsT=performance.now();
  function loop(){
    rafId = requestAnimationFrame(loop);
    if (!renderer || renderer.valid===false) return;
    try { renderer.draw(canvas); } catch(e){ /* transient */ }
    frames++;
    const now=performance.now();
    if (now-fpsT>=500){ $('fpsLabel').textContent=Math.round(frames*1000/(now-fpsT)); frames=0; fpsT=now; }
  }

  function togglePlay(){
    playing = !playing;
    $('playBtn').textContent = playing? '⏸':'▶';
    $('playBtn').classList.toggle('active', playing);
    if (playing){ if(!rafId) loop(); }
    else { cancelAnimationFrame(rafId); rafId=null; }
  }

  // ---------- helpers ----------
  function cssId(s){ return s.replace(/[^a-zA-Z0-9_]/g,'_'); }
  function fmt(v){ return (Math.round(v*1000)/1000).toString(); }
  function rgbToHex(a){ return '#'+[0,1,2].map(i=>('0'+Math.round((a[i]||0)*255).toString(16)).slice(-2)).join(''); }
  function hexToRgb(h){ const n=parseInt(h.slice(1),16); return [(n>>16&255)/255,(n>>8&255)/255,(n&255)/255]; }
  function rgbaStr(a){ return [0,1,2,3].map(i=>(a[i]!=null?a[i]:1).toFixed(2)).join(' '); }

  // ---------- wiring: drop zones ----------
  function wireDrop(el, onFile, accept){
    el.addEventListener('dragover', e=>{e.preventDefault(); el.classList.add('over');});
    el.addEventListener('dragleave', ()=>el.classList.remove('over'));
    el.addEventListener('drop', e=>{
      e.preventDefault(); el.classList.remove('over');
      const f = e.dataTransfer.files[0]; if(f) onFile(f);
    });
  }
  wireDrop($('dropFs'), f=>{ const r=new FileReader(); r.onload=()=>{ $('fsName').textContent=f.name; loadShaderSource(r.result, f.name);}; r.readAsText(f); });
  wireDrop($('dropImg'), handleImageFile);
  // whole window also accepts image drops onto the stage
  wireDrop($('cwrap'), handleImageFile);

  $('dropFs').onclick = ()=> $('fsInput').click();
  $('pickFs').onclick = ()=> $('fsInput').click();
  $('fsInput').onchange = e=>{ const f=e.target.files[0]; if(!f)return;
    const r=new FileReader(); r.onload=()=>{ $('fsName').textContent=f.name; loadShaderSource(r.result, f.name);}; r.readAsText(f); };
  $('dropImg').onclick = openImagePicker;
  $('imgInput').onchange = e=> handleImageFile(e.target.files[0]);

  // ---------- wiring: stage controls ----------
  $('playBtn').onclick = togglePlay;
  $('resetBtn').onclick = ()=>{ if(renderer){ renderer.startTime=Date.now(); renderer.frameIndex=0; } };
  $('pixelBtn').onclick = ()=>{ canvas.classList.toggle('pixel'); $('pixelBtn').classList.toggle('active'); };
  $('snapBtn').onclick = ()=>{
    // draw one fresh frame to be safe, then export
    if(renderer && renderer.valid!==false){ try{renderer.draw(canvas);}catch(e){} }
    const a=document.createElement('a');
    a.download=($('shaderName').textContent||'isf')+'_'+canvas.width+'x'+canvas.height+'.png';
    a.href=canvas.toDataURL('image/png'); a.click();
  };
  $('resSeg').querySelectorAll('button').forEach(b=>{
    b.onclick=()=>{
      $('resSeg').querySelectorAll('button').forEach(x=>x.classList.remove('on'));
      b.classList.add('on');
      resMode = b.dataset.r==='fit'?'fit':b.dataset.r;
      sizeCanvas();
    };
  });

  // keyboard
  window.addEventListener('keydown', e=>{
    if (e.target.tagName==='INPUT'||e.target.tagName==='SELECT') return;
    if (e.code==='Space'){ e.preventDefault(); togglePlay(); }
    if (e.key==='s'||e.key==='S'){ $('snapBtn').click(); }
    if (e.key==='r'||e.key==='R'){ $('resetBtn').click(); }
  });

  window.addEventListener('resize', ()=>{ if(resMode==='fit') sizeCanvas(); });

  // ---------- example shader ----------
  const EXAMPLE = `/*{
  "DESCRIPTION": "RGB split + ripple — demo for ISF Preview",
  "CREDIT": "ISF Preview",
  "CATEGORIES": ["Stylize","Distortion"],
  "INPUTS": [
    { "NAME": "inputImage", "TYPE": "image" },
    { "NAME": "amount",   "TYPE": "float", "DEFAULT": 0.02, "MIN": 0.0, "MAX": 0.12 },
    { "NAME": "rippleFreq","TYPE": "float", "DEFAULT": 14.0, "MIN": 0.0, "MAX": 60.0 },
    { "NAME": "rippleAmp", "TYPE": "float", "DEFAULT": 0.006,"MIN": 0.0, "MAX": 0.05 },
    { "NAME": "speed",     "TYPE": "float", "DEFAULT": 1.0,  "MIN": 0.0, "MAX": 4.0 },
    { "NAME": "center",    "TYPE": "point2D","DEFAULT": [0.5,0.5] },
    { "NAME": "tint",      "TYPE": "color", "DEFAULT": [1.0,1.0,1.0,1.0] },
    { "NAME": "monochrome","TYPE": "bool",  "DEFAULT": false }
  ]
}*/

void main() {
  vec2 uv = isf_FragNormCoord;
  vec2 d  = uv - center;
  float dist = length(d);
  // radial ripple displacement
  float wave = sin(dist * rippleFreq - TIME * speed * 3.0) * rippleAmp;
  vec2 ruv = uv + normalize(d + 1e-5) * wave;

  // chromatic aberration along the radial axis
  vec2 dir = normalize(d + 1e-5) * amount;
  float r = IMG_NORM_PIXEL(inputImage, ruv + dir).r;
  float g = IMG_NORM_PIXEL(inputImage, ruv).g;
  float b = IMG_NORM_PIXEL(inputImage, ruv - dir).b;
  vec4 col = vec4(r,g,b,1.0) * tint;

  if (monochrome) {
    float l = dot(col.rgb, vec3(0.299,0.587,0.114));
    col.rgb = vec3(l);
  }
  gl_FragColor = col;
}`;

  // a generated fallback image so the example shows something even with no upload
  function makeDefaultImage(cb){
    const c=document.createElement('canvas'); c.width=512;c.height=288;
    const x=c.getContext('2d');
    const g=x.createLinearGradient(0,0,512,288);
    g.addColorStop(0,'#1b2330'); g.addColorStop(1,'#0a0c10');
    x.fillStyle=g; x.fillRect(0,0,512,288);
    // grid
    x.strokeStyle='rgba(76,240,192,.35)'; x.lineWidth=1;
    for(let i=0;i<=512;i+=32){x.beginPath();x.moveTo(i,0);x.lineTo(i,288);x.stroke();}
    for(let i=0;i<=288;i+=32){x.beginPath();x.moveTo(0,i);x.lineTo(512,i);x.stroke();}
    // circles
    for(let i=0;i<5;i++){x.beginPath();x.strokeStyle='rgba(255,93,122,.6)';
      x.arc(256,144,30+i*28,0,Math.PI*2);x.stroke();}
    x.fillStyle='#e7ecf3'; x.font='bold 34px monospace'; x.textAlign='center';
    x.fillText('ISF · PREVIEW', 256, 156);
    const img=new Image(); img.onload=()=>cb(img); img.src=c.toDataURL();
  }

  $('loadExample').onclick = ()=>{
    $('fsName').textContent='example.fs';
    makeDefaultImage(img=>{
      images['inputImage'] = { img, label:'(generated test card)' };
      loadShaderSource(EXAMPLE, 'example.fs');
    });
  };

  // ---------- boot ----------
  sizeCanvas();
  loop();
})();
</script>
</body>
</html>
